# =============================================================================
# ABS IMMO & SERVICES — site public (abs-immo-frontend)
# Copier vers `.env.local` (jamais versionné) et renseigner les valeurs.
# Toutes ces variables sont PUBLIQUES : elles sont intégrées au bundle JavaScript.
# Ne jamais placer ici de clé `service_role` / `sb_secret_…`.
# =============================================================================

# Projet Supabase commun (Dashboard > Project Settings > API Keys).
# Local (pile du dépôt abs-immo-backend) : http://127.0.0.1:54621 et la clé
# affichée par `npx supabase status` dans abs-immo-backend.
VITE_SUPABASE_URL=https://sasssoloprjakfysajvt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Ancienne clé publique `anon` (JWT) : acceptée en repli si la clé publishable n'est pas définie.
# VITE_SUPABASE_ANON_KEY=

# URL publique du site, sans « / » final (balises canonical, Open Graph, sitemap.xml, robots.txt).
VITE_SITE_URL=https://www.abs-immo.sn

# Clé de site Cloudflare Turnstile (publique). Laisser vide si le CAPTCHA n'est pas activé
# côté backend (secret TURNSTILE_SECRET_KEY des Edge Functions).
VITE_TURNSTILE_SITE_KEY=
